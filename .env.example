# Supabase: textos editables, notas de invitados y login de administrador.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Email fijo del usuario de Supabase Auth que se crea a mano una sola vez
# (Authentication -> Users -> Add user) con la contraseña que van a usar
# Miqueas y Florencia para entrar en modo administrador.
VITE_WEDDING_ADMIN_EMAIL=novios@sitiodeboda.com

# Cloudinary: almacenamiento de las fotos (invitados y del sitio).
# Cloud name: Dashboard de Cloudinary, arriba a la izquierda.
# Upload preset: Settings -> Upload -> Upload presets -> Add upload preset,
# con "Signing Mode" en "Unsigned" (así se puede subir desde el navegador
# sin exponer ninguna clave secreta).
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
